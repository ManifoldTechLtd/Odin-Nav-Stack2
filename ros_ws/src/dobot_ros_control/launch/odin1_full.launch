<!--
  Combined launch for Odin1Lite driver (odin1Lite.launch) and topic/TF compatibility layer (odin1_compat.launch).

  Usage:
    roslaunch odin_ros_driver_rev1 odin1_full.launch
    roslaunch odin_ros_driver_rev1 odin1_full.launch topic_prefix:=odin1 start_rviz:=false
-->
<launch>
  <arg name="topic_prefix" default="odin1"/>
  <arg name="start_rviz"   default="false"/>
  <!-- o1l SysTick is device uptime, not ROS epoch time. -->
  <param name="/odin_ros_driver/use_host_time_offset" value="true"/>
  <!-- Do not refresh cached poses with fabricated current timestamps. -->
  <param name="/odin_ros_driver/tf_publish_rate" value="0.0"/>

  <!-- Odin1Lite driver -->
  <include file="$(find odin_ros_driver_rev1)/launch/odin1Lite.launch">
    <arg name="topic_prefix" value="$(arg topic_prefix)"/>
    <arg name="start_rviz"   value="$(arg start_rviz)"/>
  </include>

  <!-- Topic and TF compatibility layer -->
  <include file="$(find odin_ros_driver_rev1)/launch/odin1_compat.launch">
    <arg name="prefix" value="$(arg topic_prefix)"/>
  </include>
</launch>
