<!--
  dobot_ros_control launch file (ROS 1).

  Read-only health check (default, no motion commands sent):
    roslaunch dobot_ros_control dobot_control.launch

  Active control mode:
    roslaunch dobot_ros_control dobot_control.launch dry_run:=false auto_start:=true

  Override robot IP:
    roslaunch dobot_ros_control dobot_control.launch robot_ip:=192.168.5.2
-->
<launch>
  <arg name="dry_run"     default="true"/>
  <arg name="auto_start"  default="false"/>
  <arg name="backend"     default="sdk"/>
  <arg name="robot_ip"    default="192.168.5.2"/>
  <arg name="robot_port"  default="51234"/>
  <!-- Default FSM state IDs (1=damping, 100=prepare, 300=standing, 304=walk). -->
  <arg name="fsm_prepare" default="100"/>
  <arg name="fsm_walk"    default="304"/>
  <arg name="fsm_standing" default="300"/>
  <arg name="config"      default="$(find dobot_ros_control)/config/dobot_control.yaml"/>

  <node pkg="dobot_ros_control" type="dobot_cmd_vel_bridge"
        name="dobot_cmd_vel_bridge" output="screen" required="false">
    <!-- Load YAML defaults first, then override with launch arguments -->
    <rosparam command="load" file="$(arg config)"/>
    <param name="dry_run"      value="$(arg dry_run)"/>
    <param name="auto_start"   value="$(arg auto_start)"/>
    <param name="backend"      value="$(arg backend)"/>
    <param name="robot_ip"     value="$(arg robot_ip)"/>
    <param name="robot_port"   value="$(arg robot_port)"/>
    <param name="fsm_prepare"  value="$(arg fsm_prepare)"/>
    <param name="fsm_walk"    value="$(arg fsm_walk)"/>
    <param name="fsm_standing" value="$(arg fsm_standing)"/>
  </node>
</launch>
