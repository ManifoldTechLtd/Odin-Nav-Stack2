<!--
  SRU node launch (ROS1):
  1) Loads config/sru_nav.yaml, whose goal/velocity topics are the gated
     /sru/goal_pose and /sru/cmd_vel chain (sru_cmd_vel_relay.py forwards to
     /cmd_vel only while /sru/cmd_vel_enable is true, default closed).
  2) Forwards SRU_VAE_MODEL and SRU_POLICY_MODEL environment variables when set.
  Included by the platform bringup launches via robots/<robot>/robot.yaml
  (local_planner.backends.sru), and by ros_ws/scripts/start_sru.sh.
-->
<launch>
  <arg name="sim" default="false"/>

  <node pkg="sru_nav" type="sru_nav_node" name="sru_nav_node"
        output="screen" required="true">
    <rosparam command="load" file="$(find sru_nav)/config/sru_nav.yaml"/>
    <param name="use_sim"           value="$(arg sim)"/>
    <param name="vae_model_path"    value="$(optenv SRU_VAE_MODEL '')"/>
    <param name="policy_model_path" value="$(optenv SRU_POLICY_MODEL '')"/>
  </node>
</launch>