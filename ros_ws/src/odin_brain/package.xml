<package format="2">
  <name>odin_brain</name>
  <version>0.1.0</version>
  <description>
    Natural-language task layer on top of the navigation stack (ROS1 / Noetic).
    One Chinese sentence -> ordered waypoints -> /waypoint_manager/start_mission.
    The core (place store / planner / LLM client / executor) has no ROS dependency;
    only ros1_nav.py, node.py and place_tool.record touch ROS.
  </description>
  <maintainer email="yuhaowen@manifoldtech.cn">Haowen Yu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>nav_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <export/>
</package>
