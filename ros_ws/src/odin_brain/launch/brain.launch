<launch>
  <!-- Resident command node subscribing to /brain/command (for interactive CLI use: rosrun odin_brain brain). -->
  <arg name="places" default="$(find odin_brain)/config/places.json"/>
  <arg name="dry_run" default="false"/>
  <arg name="no_llm" default="false"/>
  <arg name="disable_motion" default="false"/>

  <node pkg="odin_brain" type="brain_node" name="odin_brain" output="screen">
    <param name="places" value="$(arg places)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
    <param name="no_llm" value="$(arg no_llm)"/>
    <param name="disable_motion" value="$(arg disable_motion)"/>
  </node>
</launch>
