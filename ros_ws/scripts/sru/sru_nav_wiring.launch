<!--
  SRU node topic wiring launch file for ROS1 Go2:
  1) Routes goal and velocity topics through /sru/goal_pose and /sru/cmd_vel (for sru_cmd_vel_relay gating).
  2) Forwards SRU_VAE_MODEL and SRU_POLICY_MODEL environment variables when set.
-->
<launch>
  <arg name="sim"              default="false"/>
  <arg name="require_joystick" default="false"/>

  <node pkg="sru_nav_go2_ros1" type="sru_nav_node" name="sru_nav_node"
        output="screen" required="true">
    <rosparam command="load" file="$(find sru_nav_go2_ros1)/config/sru_nav.yaml"/>
    <param name="use_sim"          value="$(arg sim)"/>
    <param name="require_joystick" value="$(arg require_joystick)"/>
    <param name="goal_topic"       value="/sru/goal_pose"/>
    <param name="cmd_vel_topic"    value="/sru/cmd_vel"/>
    <param name="vae_model_path"    value="$(optenv SRU_VAE_MODEL '')"/>
    <param name="policy_model_path" value="$(optenv SRU_POLICY_MODEL '')"/>
  </node>
</launch>
