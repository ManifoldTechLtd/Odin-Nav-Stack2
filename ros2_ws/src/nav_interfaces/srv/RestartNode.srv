#
# Request to restart a single node via system_health_monitor (/system_health/restart).
# Rate-limited (max 2 restarts per 30s per node) and rejected if the robot is moving.
string node_name    # Node name matching SystemHealth.nodes[].name
---
bool success        # True if restart was initiated; false if rejected
string message      # Human-readable result or rejection reason
