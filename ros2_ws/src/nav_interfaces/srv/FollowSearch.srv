#
# In-place stepped rotation search request when a follow target is lost.
# Returns immediately while mission_manager executes stepped turns asynchronously
# until a new dynamic_goal is received or a safety/limit condition stops the search.
float64 direction          # Rotation direction: +1 = left/CCW, -1 = right/CW
float64 last_bearing_rad   # Optional last known target bearing (rad) for logging
float64 step_deg           # Step angle (deg); 0 = use node default (90)
float64 step_pause_sec     # Pause between steps (s); 0 = use node default (0.3)
float64 total_limit_deg    # Cumulative rotation limit (deg); 0 = unlimited
float64 timeout_sec        # Search timeout (s); 0 = unlimited
float64 min_clearance_m    # Minimum all-round clearance gate (m); 0 = use node default (0.60)
---
bool accepted              # True if search started; see message on rejection
string message
