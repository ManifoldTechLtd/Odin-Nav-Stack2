<!-- A 49152 x 19-byte cloud exceeds Fast DDS's default 512 KiB SHM segment.
     Scope this profile to the filter/scan processes, not the robot driver. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>cloud_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>cloud_shm</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
      <port_queue_capacity>512</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="cloud_large_data" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>cloud_udp</transport_id>
        <transport_id>cloud_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
