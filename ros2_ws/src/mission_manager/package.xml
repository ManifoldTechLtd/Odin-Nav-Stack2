<package format="3">
  <name>mission_manager</name>
  <version>0.1.0</version>
  <description>Waypoint mission state machine: global plan dispatch, NeuPAN navPath action client, alignment handover, recovery shadow/commit, periodic replan install gate, VLM follow dynamic mode with T7 rotate-search (ROS2 Jazzy port).</description>
  <maintainer email="yuhaowen@manifoldtech.cn">Manifold Tech Ltd.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>atomic_move</depend>
  <depend>map_planner</depend>
  <depend>nav_interfaces</depend>
  <depend>neupan_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>action_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
