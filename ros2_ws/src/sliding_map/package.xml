<package format="3">
  <name>sliding_map</name>
  <version>0.1.0</version>
  <description>sliding_map (ROS2 Jazzy): rolling dynamic-obstacle memory grid and 360-degree virtual laser scan.</description>
  <maintainer email="mohongle@manifoldtech.cn">Hongle Mo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav_interfaces</depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
