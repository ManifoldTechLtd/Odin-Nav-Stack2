<package format="3">
  <name>odin_brain</name>
  <version>0.1.0</version>
  <description>
    Natural-language task &amp; agent layer on top of the navigation stack (ROS2 / Jazzy).
    Shares 100% pure-Python ROS-free core with ros_ws/src/odin_brain;
    only ros2_nav.py and node.py touch rclpy.
  </description>
  <maintainer email="yuhaowen@manifoldtech.cn">Haowen Yu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
