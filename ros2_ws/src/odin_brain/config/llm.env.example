#
# LLM configuration template for odin_brain.
#
# Usage:
#   mkdir -p ~/.config/odin_brain
#   cp llm.env.example ~/.config/odin_brain/llm.env
#   chmod 600 ~/.config/odin_brain/llm.env
#   ros2 run odin_brain check_llm
#
# Search order: $ODIN_BRAIN_LLM_ENV -> ~/.config/odin_brain/llm.env -> ~/.odin_brain.env -> ./llm.env
# Explicitly exported environment variables take precedence over this file.

# Option A: Zhipu BigModel (https://open.bigmodel.cn)
ODIN_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ODIN_LLM_API_KEY=
ODIN_LLM_MODEL=glm-4.7-flash

# Option B: OpenRouter
# ODIN_LLM_BASE_URL=https://openrouter.ai/api/v1
# ODIN_LLM_API_KEY=sk-or-v1-xxxxxxxx
# ODIN_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Option C: Local Ollama / vLLM (offline)
# ODIN_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ODIN_LLM_API_KEY=ollama
# ODIN_LLM_MODEL=qwen2.5:7b-instruct

# General parameters
ODIN_LLM_TIMEOUT=20
ODIN_LLM_TEMPERATURE=0.1
