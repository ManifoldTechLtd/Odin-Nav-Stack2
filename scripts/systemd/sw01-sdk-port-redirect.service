[Unit]
Description=SW01 SDK UDP reply port redirect (UDP 3601 -> 3600 for ASTRALL SDK 1.0.7 compatibility)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Optional: set SW01_SDK_IFACE=eno1 in /etc/default/sw01-sdk-port-redirect to restrict to a single interface.
EnvironmentFile=-/etc/default/sw01-sdk-port-redirect
ExecStart=/usr/local/sbin/sw01-sdk-port-redirect.sh add
ExecStop=/usr/local/sbin/sw01-sdk-port-redirect.sh del

[Install]
WantedBy=multi-user.target
